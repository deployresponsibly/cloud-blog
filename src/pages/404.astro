---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { href } from '../lib/content';
---

<Base title="Not found" description="This page does not exist.">
  <section class="stack">
    <h1 class="display"><span class="lead">404</span> Not found</h1>
    <p class="lede">There is nothing at this address. It may have moved, or never existed.</p>
    <a class="arrow-link label" href={href('/')}>
      <span>Back to the timeline</span>
      <Arrow />
    </a>
  </section>
</Base>
